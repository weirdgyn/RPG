<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RPG.Common\RPG.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\RPG.Common\Data\**\*.*" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Impostazioni locali del client (host/porta del server): file non pubblicato (vedi .gitignore),
       copiato accanto all'eseguibile solo se esiste. Il modello da copiare è client.settings.example.json. -->
  <ItemGroup>
    <None Update="client.settings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('client.settings.json')" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
